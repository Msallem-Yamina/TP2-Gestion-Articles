@model IEnumerable<TP_Product.Models.Product>

@{
    ViewData["Title"] = "Liste des produits";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="page-title mb-0">Gestion des Articles</h1>
        <small class="text-muted">@Model.Count() article(s)</small>
    </div>
    <a asp-action="Create" class="btn btn-success btn-lg">+ Nouvel article</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Aucun article trouvé.</div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
    @foreach (var product in Model)
    {
        var photoPath = "~/images/" + (product.Image ?? "noimage.jpg");

        <div class="col">
            <div class="card product-card shadow-sm h-100"
                 data-href="@Url.Action("Details", new { id = product.ProductId })">
                <div class="card-body">
                    <span class="badge bg-secondary mb-2">@product.Category.CategoryName</span>
                    <h5 class="card-title">
                        <a asp-action="Details" asp-route-id="@product.ProductId"
                           class="stretched-link text-decoration-none text-dark">@product.Name</a>
                    </h5>
                    @if (product.QteStock > 10)
                    {
                        <span class="badge bg-success">En stock : @product.QteStock</span>
                    }
                    else if (product.QteStock > 0)
                    {
                        <span class="badge bg-warning text-dark">Stock faible : @product.QteStock</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Rupture</span>
                    }
                </div>
                <div class="card-footer bg-white border-0 d-flex gap-2 justify-content-center pb-3">
                    <a asp-action="Details" asp-route-id="@product.ProductId"
                       class="btn btn-sm btn-outline-primary">View</a>
                    <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@product.ProductId"
                       class="btn btn-sm btn-outline-danger">Delete</a>
                </div>
            </div>
        </div>
    }
</div>