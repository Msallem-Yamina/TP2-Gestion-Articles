@model TP_Product.ViewModels.CreateRoleViewModel
@{
    ViewData["Title"] = "Nouveau rôle";
}

<div class="auth-wrapper">
    <div class="card auth-card">
        <div class="auth-header">
            <div class="auth-avatar">🛡️</div>
            <h2 class="h3 mb-1">Nouveau rôle</h2>
            <p class="mb-0 opacity-75">Ex. : Admin, Manager, User</p>
        </div>

        <div class="card-body p-4">
            <form asp-action="CreateRole" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="RoleName" class="form-control" placeholder="Nom du rôle" />
                    <label asp-for="RoleName">Nom du rôle</label>
                    <span asp-validation-for="RoleName" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-auth w-100">Créer le rôle</button>
                <a asp-action="ListRoles" class="btn btn-outline-secondary w-100 mt-2">Annuler</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}