@using TP_Product.ViewModels
@model List<UserRoleViewModel>
@{
    ViewData["Title"] = "Utilisateurs du rôle";
    var roleId = ViewBag.roleId;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <form method="post">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h4 class="mb-0">Ajouter ou retirer des utilisateurs</h4>
                </div>
                <div class="card-body">
                    @if (Model.Count == 0)
                    {
                        <p class="text-muted mb-0">Aucun utilisateur inscrit pour le moment.</p>
                    }
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <div class="form-check form-switch m-2">
                            <input type="hidden" asp-for="@Model[i].UserId" />
                            <input type="hidden" asp-for="@Model[i].UserName" />
                            <input asp-for="@Model[i].IsSelected" class="form-check-input" />
                            <label class="form-check-label" asp-for="@Model[i].IsSelected">
                                @Model[i].UserName
                            </label>
                        </div>
                    }
                </div>
                <div class="card-footer bg-white d-flex gap-2">
                    <input type="submit" value="Mettre à jour" class="btn btn-primary" />
                    <a asp-action="EditRole" asp-route-id="@roleId" class="btn btn-outline-secondary">Annuler</a>
                </div>
            </div>
        </form>
    </div>
</div>