@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "Rôles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Rôles</h1>
    <a class="btn btn-success" asp-controller="Admin" asp-action="CreateRole">+ Nouveau rôle</a>
</div>

@if (Model.Any())
{
    <div class="row g-3">
        @foreach (var role in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">Rôle</span>
                        <h5 class="card-title">@role.Name</h5>
                        <p class="text-muted small mb-0">Id : @role.Id</p>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3">
                        <form method="post" asp-action="DeleteRole" asp-route-id="@role.Id"
                              class="d-flex gap-2 align-items-center">
                            <a asp-action="EditRole" asp-route-id="@role.Id" class="btn btn-primary btn-sm">Modifier</a>

                            <span id="confirmDeleteSpan_@role.Id" style="display:none">
                                <span class="small">Confirmer ?</span>
                                <button type="submit" class="btn btn-danger btn-sm">Oui</button>
                                <a href="#" class="btn btn-secondary btn-sm"
                                   onclick="confirmDelete('@role.Id', false); return false;">Non</a>
                            </span>
                            <span id="deleteSpan_@role.Id">
                                <a href="#" class="btn btn-outline-danger btn-sm"
                                   onclick="confirmDelete('@role.Id', true); return false;">Supprimer</a>
                            </span>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm text-center p-5">
        <h5 class="mb-3">Aucun rôle créé pour le moment</h5>
        <div>
            <a class="btn btn-primary" asp-controller="Admin" asp-action="CreateRole">Créer un rôle</a>
        </div>
    </div>
}