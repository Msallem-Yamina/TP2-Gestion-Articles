@model TP_Product.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="auth-wrapper">
    <div class="card auth-card">
        <div class="auth-header">
            <div class="auth-avatar">✨</div>
            <h2 class="h3 mb-1">Créer un compte</h2>
            <p class="mb-0 opacity-75">Rejoignez la gestion des articles</p>
        </div>

        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Adresse e-mail" autocomplete="username" />
                    <label asp-for="Email">Adresse e-mail</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="input-group mb-1">
                    <div class="form-floating">
                        <input asp-for="Password" class="form-control" placeholder="Mot de passe"
                               autocomplete="new-password" />
                        <label asp-for="Password">Mot de passe</label>
                    </div>
                    <button type="button" class="btn btn-outline-secondary toggle-password" tabindex="-1"
                            aria-label="Afficher ou masquer le mot de passe">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
                <div class="form-text mb-3">6 caractères minimum, avec au moins un chiffre et une minuscule.</div>

                <div class="input-group mb-1">
                    <div class="form-floating">
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmer"
                               autocomplete="new-password" />
                        <label asp-for="ConfirmPassword">Confirmer le mot de passe</label>
                    </div>
                    <button type="button" class="btn btn-outline-secondary toggle-password" tabindex="-1"
                            aria-label="Afficher ou masquer le mot de passe">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mb-3"></span>

                <button type="submit" class="btn btn-primary btn-auth w-100">S'inscrire</button>
            </form>

            <hr class="my-4" />
            <p class="text-center text-muted mb-0">
                Déjà inscrit ?
                <a asp-controller="Account" asp-action="Login">Se connecter</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}