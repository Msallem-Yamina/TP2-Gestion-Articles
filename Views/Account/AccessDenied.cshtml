@{
    ViewData["Title"] = "Accès refusé";
}

<div class="auth-wrapper">
    <div class="card auth-card text-center">
        <div class="auth-header" style="background: linear-gradient(135deg, #c0392b, #e74c3c);">
            <div class="auth-avatar">⛔</div>
            <h2 class="h3 mb-1">Accès refusé</h2>
            <p class="mb-0 opacity-75">Vous n'avez pas la permission de voir cette page</p>
        </div>
        <div class="card-body p-4">
            <p class="text-muted">Contactez un administrateur si vous pensez qu'il s'agit d'une erreur.</p>
            <a class="btn btn-primary btn-auth w-100" asp-controller="Product" asp-action="Index">Retour à l'accueil</a>
        </div>
    </div>
</div>